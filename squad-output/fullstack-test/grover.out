+// grover-pw-test.mjs — Playwright headless test runner for live game
+// Verifies delta-time physics fix has not broken gameplay
+import { chromium } from 'playwright';
+
+const LIVE_URL = 'https://klampatech.github.io/rogue-pachinko/';
+const OUT_DIR = process.env.OUT_DIR || '/tmp';
+
+// ── helpers ──────────────────────────────────────────────────────────────────
+function collectConsoleMessages(page) {
+  const msgs = [];
+  page.on('console', msg => msgs.push({ type: msg.type(), text: msg.text() }));
+  page.on('pageerror', err => msgs.push({ type: 'pageerror', text: String(err) }));
+  return msgs;
+}
+
+// ── wait for game to be ready ──────────────────────────────────────────────────
+async function waitForGameReady(page, timeout = 15000) {
+  await page.goto(LIVE_URL, { waitUntil: 'networkidle', timeout });
+  // Wait for canvas to appear
+  await page.waitForSelector('canvas', { timeout });
+  // Wait for game loop to initialize
+  await page.waitForFunction(() => typeof GS !== 'undefined' && GS.screen !== undefined, { timeout });
+}
+
+// ── core gameplay tests ───────────────────────────────────────────────────────
+async function runGameplayTests(page) {
+  const results = [];
+
+  // TEST: Canvas exists and has correct dimensions
+  results.push(await test('Canvas exists', async () => {
+    const canvas = await page.$('canvas');
+    if (!canvas) throw new Error('No canvas element');
+    const box = await canvas.boundingBox();
+    if (!box || box.width === 0 || box.height === 0) throw new Error('Canvas has zero dimensions');
+  }));
+
+  // TEST: GS object initialized
+  results.push(await test('GS object initialized', async () => {
+    const gs = await page.evaluate(() => GS);
+    if (!gs) throw new Error('GS not defined');
+    if (typeof gs.screen === 'undefined') throw new Error('GS.screen undefined');
+  }));
+
+  // TEST: Menu screen on load
+  results.push(await test('Menu screen on load', async () => {
+    const screen = await page.evaluate(() => GS.screen);
+    if (screen !== 'menu') throw new Error(`Expected screen=menu, got=${screen}`);
+  }));
+
+  // TEST: Start game and verify board generates
+  results.push(await test('startRun generates board', async () => {
+    await page.evaluate(() => { startRun(); });
+    await page.waitForFunction(() => GS.board && GS.board.length > 0, { timeout: 5000 });
+    const boardLen = await page.evaluate(() => GS.board.length);
+    if (boardLen === 0) throw new Error('Board not generated');
+  }));
+
+  // TEST: Ball drop creates a ball in ballsInPlay
+  results.push(await test('dropBall creates ball in play', async () => {
+    await page.evaluate(() => { startRun(); });
+    await page.waitForFunction(() => GS.board && GS.board.length > 0, { timeout: 5000 });
+    await page.evaluate(() => { dropBall(); });
+    const count = await page.evaluate(() => GS.ballsInPlay.length);
+    if (count === 0) throw new Error('No ball in play after dropBall');
+  }));
+
+  // TEST: Ball falls correctly (delta-time physics)
+  results.push(await test('Ball falls under gravity (delta-time physics)', async () => {
+    await page.evaluate(() => { startRun(); });
+    await page.waitForFunction(() => GS.board && GS.board.length > 0, { timeout: 5000 });
+    await page.evaluate(() => { dropBall(); });
+    // Get initial ball y position
+    const y0 = await page.evaluate(() => GS.ballsInPlay[0]?.y ?? -1);
+    if (y0 < 0) throw new Error('Ball not created');
+    // Wait 60 frames (~1 second at 60fps)
+    await page.waitForTimeout(1100);
+    const y1 = await page.evaluate(() => GS.ballsInPlay[0]?.y ?? y0);
+    if (y1 <= y0) throw new Error(`Ball did not fall: y0=${y0}, y1=${y1}`);
