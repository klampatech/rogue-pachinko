import sys
content = open('tests/index.html').read()
# Simple JS syntax check via node eval of just the modified runAll function
import re
m = re.search(r'async function runAll\(\) \{', content)
if m:
    print('runAll() found at offset', m.start())
    # Check for balanced braces in the file
    in_script = False
    brace_depth = 0
    lines = content.split('\n')
    for i, line in enumerate(lines, 1):
        if '<script type=\"module\">' in line:
            in_script = True
        if in_script:
            for ch in line:
                if ch == '{':
                    brace_depth += 1
                elif ch == '}':
                    brace_depth -= 1
            if '</script>' in line:
                break
    print('Final brace depth after script:', brace_depth)
    if brace_depth == 0:
        print('Braces balanced — script looks correct')
    else:
        print('BRACE MISMATCH — potential issue')
