        const mod = await import(testUrl.href);
        const results = await mod.runTests(TEST);
        // results is [{name, status, ms, err?}]
        // Update harness: total += results.length, pass += 
results.filter(r=>r.status==="PASS").length
        // Append to results list
   d. If import() fails (CORS), use data: URI fallback inside iframe:
        const code = await (await fetch(testUrl.href)).text();
        const results = await iframe.contentWindow.eval(`
          (async () => {
            const G = { current: window.GS };
            const P = { current: window.PERSIST };
            const T = {
              getGS: () => G.current,
              getPersist: () => P.current,
              ok: (e, m) => { if(!e) throw new Error(m||""); return true; },
              log: (...a) => console.log("[TEST]", ...a),
            };
            const mod = await import("data:text/javascript," + 
encodeURIComponent(code));
            return await mod.runTests(T);
          })()
        `);

